# Set these in Netlify: Site configuration > Environment variables (never commit real values).

# REQUIRED - password for /admin
ADMIN_PASSWORD=choose-a-long-random-password
# Optional - signing key for admin tokens (falls back to ADMIN_PASSWORD)
ADMIN_SECRET=another-long-random-string

# OPTIONAL - email alert for each enquiry via https://resend.com (free tier)
RESEND_API_KEY=
NOTIFY_TO=vrktax2024@gmail.com
# Must be a verified sender/domain in Resend; default works for testing only
NOTIFY_FROM=VRK Website <onboarding@resend.dev>
